# ==========================================
# TERANG - TERPUSAT ENVIRONMENT CONFIGURATION EXAMPLE
# ==========================================

# SERVER CONFIGURATION
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# GEMINI AI CONFIGURATION
# Set your Gemini API key from Google AI Studio / GCP Console
GEMINI_API_KEY=MY_GEMINI_API_KEY
GEMINI_MODEL_NAME=gemini-3.8-flash

# ADMINISTRATOR & SESSION SECURITY CREDENTIALS
AUTH_SECRET=replace-with-a-long-random-secret
DEMO_PASSWORD=change-this-demo-password

# SUPERAGENT AUTOMATION DEFAULTS
SUPERAGENT_AUTOPILOT_DEFAULT=true
SUPERAGENT_SCAN_INTERVAL_MS=5000
